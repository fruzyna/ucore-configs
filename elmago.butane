variant: fcos
version: 1.6.0

passwd:
  users:
    - name: core
      should_exist: false
    - name: liam
      groups:
        - wheel
      ssh_authorized_keys_local:
        - keys/liam_id_ecdsa.pub
        - keys/backup_id_ed25519.pub
      password_hash: $y$j9T$fOs/Fg7ItU93I9fBHyMAz.$VsTug3VRM3pjZZEoIKxaMio7EjUiR4wKQwPOjilbqZ9
    - name: syncoid
      ssh_authorized_keys_local:
        - keys/syncoid_id_ed25519.pub
    - name: power
      ssh_authorized_keys_local:
        - keys/power_id_ed25519.pub
    - name: ellen
      no_create_home: true
      shell: /usr/sbin/nologin

storage:
  directories:
    - path: /etc/ucore-autorebase
      mode: 0754

    # create directory structure for user services
    - path: /home/liam/.config
      mode: 0755
      user:
        name: liam
      group:
        name: liam
    - path: /home/liam/.config/systemd
      mode: 0755
      user:
        name: liam
      group:
        name: liam
    - path: /home/liam/.config/systemd/user
      mode: 0755
      user:
        name: liam
      group:
        name: liam
    - path: /home/liam/.config/systemd/user/default.target.wants
      mode: 0755
      user:
        name: liam
      group:
        name: liam

  files:
    # set hostname to ELMAGO
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: |
          ELMAGO

    # enable power user to use poweroff, reboot, and shutdown without password
    - path: /etc/sudoers.d/power
      mode: 0440
      contents:
        inline: |
          power ALL=NOPASSWD: /usr/bin/poweroff, /usr/bin/reboot, /usr/bin/shutdown

    # enable zfs kmod (won't work until after secureboot enrollment)
    - path: /etc/modules-load.d/zfs.conf
      mode: 0644
      contents:
        inline: |
          zfs

    # add a prompt to enroll the secureboot key on login
    - path: /etc/profile.d/enroll-secureboot.sh
      mode: 0644
      contents:
        local: files/enroll-secureboot.sh

    # enable linger
    - path: /var/lib/systemd/linger/liam
      mode: 0644

    # configure smb
    - path: /etc/samba/smb.conf
      mode: 0644
      overwrite: true
      contents:
        local: config/elmago/smb.conf

    # configure sanoid
    - path: /etc/sanoid/sanoid.conf
      mode: 0644
      overwrite: true
      contents:
        local: config/elmago/sanoid.conf

    # add sync services and timers
    - path: /etc/systemd/user/backup-lakefront.timer
      mode: 0644
      contents:
        local: sync/elmago/backup-lakefront.timer
    - path: /etc/systemd/user/backup-lakefront.service
      mode: 0644
      contents:
        local: sync/elmago/backup-lakefront.service
    - path: /etc/systemd/user/backup-sloan.timer
      mode: 0644
      contents:
        local: sync/elmago/backup-sloan.timer
    - path: /etc/systemd/user/backup-sloan.service
      mode: 0644
      contents:
        local: sync/elmago/backup-sloan.service
    - path: /etc/systemd/user/backup-wrigley.timer
      mode: 0644
      contents:
        local: sync/elmago/backup-wrigley.timer
    - path: /etc/systemd/user/backup-wrigley.service
      mode: 0644
      contents:
        local: sync/elmago/backup-wrigley.service

  links:
    # configure the localtime to America/Chicago
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/America/Chicago

    # enable rootless podman autostart
    - path: /home/liam/.config/systemd/user/default.target.wants/podman-restart.service
      user:
        name: liam
      group:
        name: liam
      target: /usr/lib/systemd/user/podman-restart.service
      hard: false

    # enable backups
    - path: /home/liam/.config/systemd/user/default.target.wants/backup-lakefront.timer
      user:
        name: liam
      group:
        name: liam
      target: /etc/systemd/user/backup-lakefront.timer
      hard: false
    - path: /home/liam/.config/systemd/user/default.target.wants/backup-sloan.timer
      user:
        name: liam
      group:
        name: liam
      target: /etc/systemd/user/backup-sloan.timer
      hard: false
    - path: /home/liam/.config/systemd/user/default.target.wants/backup-wrigley.timer
      user:
        name: liam
      group:
        name: liam
      target: /etc/systemd/user/backup-wrigley.timer
      hard: false

systemd:
  units:
    # two step ucore rebase process, reboots after each step
    - name: ucore-unsigned-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to unsigned OCI and reboot
        ConditionPathExists=!/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/ublue-os/ucore:stable-nvidia
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified
        ExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
    - name: ucore-signed-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to signed OCI and reboot
        ConditionPathExists=/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-image-signed:docker://ghcr.io/ublue-os/ucore:stable-nvidia
        ExecStart=nmcli c modify "Wired connection 1" 802-3-ethernet.wake-on-lan magic
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/signed
        ExecStart=/usr/bin/systemctl disable ucore-signed-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target

    # disable zincati disabled motd warning
    - name: coreos-container-signing-migration-motd.service
      enabled: false

    # disable firewalld
    - name: dbus-org.fedoraproject.FirewallD1.service
      enabled: false
      mask: true
    - name: firewalld.service
      enabled: false
      mask: true

    # enable podman autostart
    - name: podman-restart.service
      enabled: true

    # enable samba
    - name: smb.service
      enabled: true

    # enable sanoid
    - name: sanoid-prune.service
      enabled: true
    - name: sanoid.timer
      enabled: true
